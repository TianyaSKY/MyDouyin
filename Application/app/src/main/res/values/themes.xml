<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Application" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color (Douyin red) -->
        <item name="colorPrimary">#FE2C55</item>
        <item name="colorPrimaryVariant">#E91E43</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <!-- Secondary -->
        <item name="colorSecondary">#25F4EE</item>
        <item name="colorSecondaryVariant">#1AD4CB</item>
        <item name="colorOnSecondary">#000000</item>
        <!-- Background -->
        <item name="android:colorBackground">#0D0D0D</item>
        <item name="colorSurface">#1A1A1A</item>
        <item name="colorOnSurface">#FFFFFF</item>
        <!-- Status bar -->
        <item name="android:statusBarColor">#00000000</item>
        <item name="android:navigationBarColor">#0D0D0D</item>
        <item name="android:windowTranslucentStatus">true</item>
        <!-- Text input styling -->
        <item name="colorControlActivated">#FE2C55</item>
        <item name="colorControlHighlight">#33FE2C55</item>
    </style>
</resources>